{
  "name": "spraxium-rpc-workspace",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spraxium/rpc.git"
  },
  "homepage": "https://github.com/spraxium/rpc#readme",
  "bugs": {
    "url": "https://github.com/spraxium/rpc/issues"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.json",
    "test": "pnpm build && vitest run --exclude **/process.test.ts",
    "test:framework": "vitest run packages/spraxium/test/process.test.ts",
    "example:bot": "pnpm --filter @spraxium/rpc-example-bot start",
    "example:nestjs": "pnpm --filter @spraxium/rpc-example-nestjs start",
    "example:hono": "pnpm --filter @spraxium/rpc-example-hono start",
    "example:fastify": "pnpm --filter @spraxium/rpc-example-fastify start",
    "example:express": "pnpm --filter @spraxium/rpc-example-express start",
    "example:koa": "pnpm --filter @spraxium/rpc-example-koa start",
    "example:node-http": "pnpm --filter @spraxium/rpc-example-node-http start",
    "example:node-client": "pnpm --filter @spraxium/rpc-example-node-client start",
    "example:commonjs": "pnpm --filter @spraxium/rpc-example-node-client start:cjs",
    "test:examples": "pnpm build && vitest run --config tests/examples/vitest.config.ts",
    "test:packages": "pnpm build && vitest run --config tests/packages/vitest.config.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "changeset": "changeset",
    "version": "changeset version",
    "commitlint": "commitlint",
    "prepare": "husky",
    "proto:lint": "buf lint && buf format --diff --exit-code",
    "proto:generate": "buf generate && biome check --write packages/protocol/src/gen",
    "proto:check": "pnpm proto:generate && git diff --exit-code -- packages/protocol/src/gen",
    "proto:breaking": "buf breaking --against compatibility/v1.binpb",
    "check": "pnpm proto:lint && pnpm proto:breaking && pnpm proto:check && pnpm lint && pnpm build && pnpm typecheck && vitest run --exclude **/process.test.ts && vitest run --config tests/packages/vitest.config.ts",
    "test:interop": "pnpm build && vitest run --config tests/interop/vitest.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "catalog:",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@types/node": "22.20.5",
    "husky": "9.1.7",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
