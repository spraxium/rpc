{
  "name": "@spraxium/rpc",
  "version": "0.1.0",
  "description": "Authenticated ConnectRPC handlers for Spraxium bots with native shard IPC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spraxium/rpc.git",
    "directory": "packages/spraxium"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test"
  },
  "dependencies": {
    "@connectrpc/connect": "catalog:",
    "@connectrpc/connect-node": "catalog:",
    "@spraxium/rpc-protocol": "workspace:*",
    "reflect-metadata": "catalog:"
  },
  "peerDependencies": {
    "@spraxium/common": ">=0.3.0 <1.0.0",
    "@spraxium/core": ">=0.3.0 <1.0.0",
    "@spraxium/logger": ">=0.3.0 <1.0.0",
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@spraxium/common": "catalog:",
    "@spraxium/core": "catalog:",
    "@spraxium/logger": "catalog:",
    "@spraxium/rpc-client": "workspace:*",
    "discord.js": "catalog:"
  },
  "engines": {
    "node": ">=22.23.2 <27"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": true
}
