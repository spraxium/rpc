{
  "name": "@spraxium/rpc-protocol",
  "version": "0.1.0",
  "description": "Versioned Protobuf gateway and JSON contract for Spraxium RPC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spraxium/rpc.git",
    "directory": "packages/protocol"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./proto/*": "./proto/*"
  },
  "files": ["dist", "proto"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepack": "node -e \"require('node:fs').cpSync('../../proto','proto',{recursive:true})\"",
    "postpack": "node -e \"const fs=require('node:fs'),p=require('node:path').resolve('proto');if(require('./package.json').name!=='@spraxium/rpc-protocol')throw Error('Wrong package');if(fs.existsSync(p))fs.rmSync(p,{recursive:true,force:true});\""
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:"
  },
  "engines": {
    "node": ">=22.23.2 <27"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
