{
  "name": "@spraxium/rpc",
  "version": "0.10.1",
  "description": "Authenticated ConnectRPC handlers for Spraxium bots with native shard IPC",
  "homepage": "https://spraxium.com/en/guide/rpc-overview",
  "bugs": {
    "url": "https://github.com/spraxium/rpc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spraxium/rpc.git",
    "directory": "packages/spraxium"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "node ../../scripts/verify-framework.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test"
  },
  "dependencies": {
    "@connectrpc/connect": "catalog:",
    "@spraxium/rpc-protocol": "workspace:*",
    "reflect-metadata": "catalog:",
    "@spraxium/rpc-server": "workspace:*"
  },
  "peerDependencies": {
    "@spraxium/common": "^0.10.0",
    "@spraxium/core": "^0.10.0",
    "@spraxium/logger": "^0.10.0",
    "discord.js": "^14.28.1"
  },
  "devDependencies": {
    "@connectrpc/connect-node": "catalog:",
    "@spraxium/common": "catalog:",
    "@spraxium/core": "catalog:",
    "@spraxium/logger": "catalog:",
    "@spraxium/rpc-client": "workspace:*",
    "discord.js": "catalog:"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": true
}
