{
  "name": "@spraxium/rpc-protocol",
  "version": "0.1.0",
  "description": "Versioned Protobuf gateway and JSON contract for Spraxium RPC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spraxium/rpc.git",
    "directory": "packages/protocol"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./proto/*": "./proto/*"
  },
  "files": ["dist", "proto"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/stage-proto.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:"
  },
  "engines": {
    "node": ">=22.23.2 <27"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
